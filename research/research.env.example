# Copy to research/research.env (gitignored). The bot's .env is never read by the adapter.
RESEARCH_STANDARD_URL=http://127.0.0.1:8790
RESEARCH_STANDARD_MODEL=grok-4.3
RESEARCH_STANDARD_EFFORT=high
RESEARCH_DEEP_URL=http://127.0.0.1:8791
RESEARCH_DEEP_MODEL=grok-4.7
RESEARCH_DEEP_EFFORT=low
RESEARCH_DEEP_ENABLED=false
RESEARCH_TIMEOUT_STANDARD_S=190
RESEARCH_TIMEOUT_DEEP_S=120
RESEARCH_MAX_IN_FLIGHT=1
RESEARCH_MAX_RETRIES=2
RESEARCH_CACHE_TTL_S=900
RESEARCH_BUDGET_TOTAL_USD=5.00
RESEARCH_BUDGET_DAILY_USD=0.50
RESEARCH_WORST_CASE_GROK_4_3=0.20
RESEARCH_WORST_CASE_GROK_4_7=0.15
RESEARCH_PRICE_GROK_4_3=1.25,0.20,2.50
RESEARCH_PRICE_GROK_4_7=2.00,0.50,6.00
RESEARCH_HELIUS_DAILY_CREDITS=4000
RESEARCH_HELIUS_TOTAL_CREDITS=100000

# Phase 3 Telegram commands (read by telegram_cmds.py; process env wins over this file)
RESEARCH_COMMANDS_ENABLED=false
RESEARCH_TESTER_IDS=2038104261
RESEARCH_CHAT_IDS=-5178862838,2038104261
RESEARCH_MAX_QUEUE=3

# ---- Phase 6: automatic research (OFF; effective defaults are zero) ----
# Proposed pilot values (need Bala's approval before setting): ENABLED=true, CHAT_IDS=-5178862838,
# MAX_PER_DAY=3, DAILY_USD=0.15, DAILY_HELIUS_CREDITS=1000. Auto spend also counts toward the global limits above.
AUTO_RESEARCH_ENABLED=false
AUTO_RESEARCH_CHAT_IDS=
AUTO_RESEARCH_MAX_PER_DAY=0
AUTO_RESEARCH_DAILY_USD=0
AUTO_RESEARCH_DAILY_HELIUS_CREDITS=0
AUTO_RESEARCH_MAX_QUEUE=2
AUTO_RESEARCH_STALE_S=600
# Startup catch-up of claims missed during a restart (OFF). Bounded: window (s) and max signatures.
CATCHUP_ENABLED=false
CATCHUP_WINDOW_S=900
CATCHUP_MAX_SIGS=25
