# Phase 7.1 outbound webhook (GitClaim -> Jed). Copy to research/webhook.env (gitignored, chmod 600).
# OFF by default. Missing or invalid values = fail closed (webhooks stay off, alerts unaffected).
WEBHOOK_ENABLED=false
WEBHOOK_URL=
# >= 32 random characters, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WEBHOOK_SECRET=
# Rotation: set the new secret here. Requests carry both signatures until WEBHOOK_SECRET is replaced and this is cleared.
WEBHOOK_SECRET_NEXT=
WEBHOOK_SEND_CLAIMS=false
WEBHOOK_SEND_RESEARCH=false
WEBHOOK_TIMEOUT_SECONDS=8
WEBHOOK_MAX_RETRIES=5
WEBHOOK_QUEUE_LIMIT=1000
WEBHOOK_EVENT_TTL_HOURS=24
# Never in production: allows http://127.0.0.1 / localhost receivers for isolated local tests only.
WEBHOOK_TEST_MODE=false
# Catch-up/replay claims are not published unless this is true (default false).
WEBHOOK_SEND_CATCHUP=false
